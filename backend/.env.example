DATABASE_URL=postgresql+psycopg://recoverai:recoverai@localhost:5433/recoverai

# Razorpay test-mode keys. Leave empty to use the built-in checkout simulator.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# REQUIRED: webhooks are rejected (503) while this is empty, because an empty
# HMAC secret would let anyone forge payment confirmations.
RAZORPAY_WEBHOOK_SECRET=change-me-to-a-long-random-string

ENVIRONMENT=development
AUTH_MODE=development
DEV_MERCHANT_ID=b614b90f-49fd-4d6a-8689-52d4d2878b03

# Production auth: signs merchant API tokens.
# Mint one with: python backend/scripts/issue_merchant_token.py <merchant_uuid>
AUTH_TOKEN_SECRET=

# Browser origins allowed to call the API (comma separated).
CORS_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:5174,http://localhost:5174

# Optional AI strategist. Empty = deterministic decisions only.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Test suite only. Must be a dedicated database whose name contains "test";
# the tests delete all rows in it.
# TEST_DATABASE_URL=postgresql+psycopg://recoverai:recoverai@localhost:5433/recoverai_test
